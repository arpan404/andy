{
  "schemaVersion": "1",
  "id": "andy.skills.shell-note",
  "name": "Shell Note",
  "version": "0.1.0",
  "description": "Run an approval-gated shell command and save a note about the requested operation.",
  "risk": "critical",
  "requiredPlugins": ["andy.shell", "andy.memory.markdown"],
  "requiredCapabilities": ["shell.execute", "memory.save"],
  "workflows": [
    {
      "name": "run-and-record",
      "description": "Execute a shell command through the shell plugin and record the requested operation through memory.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": { "type": "string" },
          "cwd": { "type": "string" },
          "noteKey": { "type": "string" }
        },
        "required": ["command", "cwd", "noteKey"],
        "additionalProperties": true
      },
      "steps": [
        {
          "id": "execute-command",
          "toolName": "andy.shell.shell.execute",
          "description": "Execute the requested command through the approval-gated shell plugin.",
          "input": {
            "command": "{{input.command}}",
            "cwd": "{{input.cwd}}"
          }
        },
        {
          "id": "record-command",
          "toolName": "andy.memory.markdown.memory.save",
          "description": "Record the shell operation request in Markdown memory.",
          "input": {
            "scope": "session",
            "namespace": "shell",
            "key": "{{input.noteKey}}",
            "value": "{{steps.execute-command.output}}",
            "source": "andy.skills.shell-note"
          }
        }
      ]
    }
  ]
}
