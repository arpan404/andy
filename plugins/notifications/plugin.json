{
  "id": "andy.notifications",
  "name": "Notifications",
  "version": "0.1.0",
  "entry": "./dist/index.js",
  "binaryEntrypoint": "./dist/plugin",
  "executionMode": "subprocess",
  "capabilities": ["notification.send", "notification.approval_request"],
  "risk": "medium",
  "tools": [
    {
      "name": "notification.send",
      "description": "Record and dispatch a local notification through the configured notification surface.",
      "capabilities": ["notification.send"],
      "risk": "medium",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess"],
        "reason": "Notifications are external user-visible actions and remain policy-gated."
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "channel": { "type": "string" },
          "urgency": { "type": "string" }
        },
        "required": ["text"],
        "additionalProperties": false
      }
    },
    {
      "name": "notification.approval_request",
      "description": "Record and dispatch an approval-request notification.",
      "capabilities": ["notification.approval_request"],
      "risk": "high",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess"],
        "reason": "Approval notifications are visible security prompts and are audited by core."
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "approvalId": { "type": "string", "minLength": 1 },
          "toolName": { "type": "string" },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "channel": { "type": "string" }
        },
        "required": ["approvalId"],
        "additionalProperties": false
      }
    }
  ]
}
