{
  "id": "andy.mcp.client",
  "name": "MCP Client Adapter",
  "version": "0.1.0",
  "entry": "./dist/index.js",
  "binaryEntrypoint": "./dist/plugin",
  "executionMode": "subprocess",
  "capabilities": ["mcp.connect", "mcp.list_tools", "mcp.call_tool"],
  "risk": "critical",
  "tools": [
    {
      "name": "mcp.list_tools",
      "description": "Start an explicit MCP stdio server command, initialize it, and list its tools.",
      "capabilities": ["mcp.connect", "mcp.list_tools"],
      "risk": "high",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess"],
        "reason": "MCP servers are external tool providers and must remain policy-gated."
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string" },
          "timeoutMs": { "type": "number", "minimum": 1 }
        },
        "required": ["command"],
        "additionalProperties": false
      }
    },
    {
      "name": "mcp.call_tool",
      "description": "Call one tool on an explicit MCP stdio server command.",
      "capabilities": ["mcp.connect", "mcp.call_tool"],
      "risk": "critical",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess"],
        "reason": "MCP tool calls can access external data/actions and require Andy policy/audit."
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string" },
          "toolName": { "type": "string", "minLength": 1 },
          "input": {},
          "timeoutMs": { "type": "number", "minimum": 1 }
        },
        "required": ["command", "toolName"],
        "additionalProperties": false
      }
    }
  ]
}
