{
  "schemaVersion": "0.1.0",
  "id": "andy.codex",
  "name": "Codex",
  "version": "0.1.0",
  "entry": "./src/index.ts",
  "binaryEntrypoint": "./dist/plugin",
  "executionMode": "subprocess",
  "risk": "critical",
  "capabilities": ["codex.run", "codex.thread"],
  "permissions": {
    "filesystem": {
      "readRoots": ["."],
      "writeRoots": ["."]
    },
    "network": {
      "allowedHosts": ["chatgpt.com", "api.openai.com"]
    }
  },
  "tools": [
    {
      "name": "codex.run",
      "description": "Delegate a coding task to the locally authenticated OpenAI Codex SDK/app-server flow.",
      "capabilities": ["codex.run"],
      "risk": "critical",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess"],
        "reason": "Codex runs as a nested local coding agent and may inspect or edit the configured working directory."
      },
      "inputSchema": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "prompt": { "type": "string" },
          "threadId": { "type": "string" },
          "cwd": { "type": "string" }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["result"],
        "properties": {
          "result": {},
          "threadId": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  ]
}
