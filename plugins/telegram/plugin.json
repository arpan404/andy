{
  "id": "andy.messaging.telegram",
  "name": "Telegram Messaging",
  "version": "0.1.0",
  "entry": "./dist/index.js",
  "binaryEntrypoint": "./dist/plugin",
  "executionMode": "subprocess",
  "capabilities": [
    "messaging.receive",
    "messaging.send",
    "messaging.manage_webhook",
    "messaging.read_contact",
    "messaging.map_identity"
  ],
  "risk": "high",
  "tools": [
    {
      "name": "telegram.listen",
      "description": "Poll Telegram Bot API updates and normalize inbound text messages.",
      "capabilities": ["messaging.receive"],
      "risk": "high",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess", "container"],
        "reason": "Telegram polling uses declared network and secret scopes."
      }
    },
    {
      "name": "telegram.sendMessage",
      "description": "Send an outbound Telegram message through the official Bot API.",
      "capabilities": ["messaging.send"],
      "risk": "high",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess", "container"],
        "reason": "Outbound external communication is policy-gated."
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "chatId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "parseMode": { "type": "string" },
          "replyToMessageId": { "type": "string" }
        },
        "required": ["chatId", "text"],
        "additionalProperties": false
      }
    },
    {
      "name": "telegram.setWebhook",
      "description": "Configure Telegram webhook delivery using the official Bot API.",
      "capabilities": ["messaging.manage_webhook"],
      "risk": "high",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess", "container"],
        "reason": "Webhook management changes a remote control surface."
      }
    },
    {
      "name": "telegram.normalizeUpdate",
      "description": "Normalize one Telegram webhook update into Andy messaging shape.",
      "capabilities": ["messaging.receive", "messaging.map_identity"],
      "risk": "medium",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess", "container"],
        "reason": "Normalization does not require additional host privileges."
      }
    }
  ],
  "permissions": {
    "network": {
      "allowedHosts": ["api.telegram.org"]
    },
    "secrets": {
      "scopes": ["telegram.bot_token", "telegram.webhook_secret"]
    }
  }
}
