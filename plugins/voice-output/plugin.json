{
  "id": "andy.voice.output",
  "name": "Voice Output",
  "version": "0.1.0",
  "entry": "./dist/index.js",
  "binaryEntrypoint": "./dist/plugin",
  "executionMode": "subprocess",
  "capabilities": ["voice.speak", "voice.stop", "speaker.speak"],
  "risk": "medium",
  "tools": [
    {
      "name": "voice.speak",
      "description": "Speak text through the current platform text-to-speech adapter.",
      "capabilities": ["voice.speak", "speaker.speak"],
      "risk": "medium",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess"],
        "reason": "Speech output is explicit and cancellable through process control."
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "voice": { "type": "string" },
          "rate": { "type": "number" }
        },
        "required": ["text"],
        "additionalProperties": false
      }
    },
    {
      "name": "voice.stop",
      "description": "Stop the active local speech process when one is running.",
      "capabilities": ["voice.stop", "speaker.speak"],
      "risk": "low",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess"],
        "reason": "Speech interruption only terminates the plugin-owned speech process."
      },
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ]
}
