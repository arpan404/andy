{
  "id": "andy.memory.markdown",
  "name": "Markdown Memory",
  "version": "0.1.0",
  "entry": "./dist/index.js",
  "executionMode": "subprocess",
  "capabilities": [
    "memory.fetch",
    "memory.save",
    "memory.save_fact",
    "memory.query",
    "memory.forget",
    "memory.list",
    "filesystem.read",
    "filesystem.write"
  ],
  "risk": "high",
  "tools": [
    {
      "name": "memory.save",
      "description": "Save or update a memory record in the Markdown memory file.",
      "capabilities": ["memory.save", "filesystem.write"],
      "risk": "medium",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess", "container"],
        "reason": "Markdown memory only needs plugin storage filesystem access."
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": ["user", "project", "session", "agent", "plugin"]
          },
          "namespace": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "value": {},
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "trust": { "enum": ["trusted", "untrusted", "derived"] },
          "source": { "type": "string" },
          "expiresAt": { "type": "string" }
        },
        "required": ["key", "value"],
        "additionalProperties": false
      }
    },
    {
      "name": "memory.save_fact",
      "description": "Save a factual memory, defaulting to the facts namespace and fact tag.",
      "capabilities": ["memory.save_fact", "filesystem.write"],
      "risk": "medium",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess", "container"],
        "reason": "Markdown memory only needs plugin storage filesystem access."
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": ["user", "project", "session", "agent", "plugin"]
          },
          "namespace": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "value": {},
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "trust": { "enum": ["trusted", "untrusted", "derived"] },
          "source": { "type": "string" },
          "expiresAt": { "type": "string" }
        },
        "required": ["key", "value"],
        "additionalProperties": false
      }
    },
    {
      "name": "memory.fetch",
      "description": "Fetch one memory by id or by a narrow query.",
      "capabilities": ["memory.fetch", "filesystem.read"],
      "risk": "low",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess", "container"],
        "reason": "Markdown memory only needs plugin storage filesystem access."
      }
    },
    {
      "name": "memory.query",
      "description": "Query Markdown memory records by scope, namespace, key, tags, or text.",
      "capabilities": ["memory.query", "filesystem.read"],
      "risk": "low",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess", "container"],
        "reason": "Markdown memory only needs plugin storage filesystem access."
      }
    },
    {
      "name": "memory.list",
      "description": "List Markdown memory records using optional filters.",
      "capabilities": ["memory.list", "filesystem.read"],
      "risk": "low",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess", "container"],
        "reason": "Markdown memory only needs plugin storage filesystem access."
      }
    },
    {
      "name": "memory.forget",
      "description": "Forget one memory record by id.",
      "capabilities": ["memory.forget", "filesystem.write"],
      "risk": "medium",
      "sandbox": {
        "isolation": "sandboxed",
        "compatibleExecutionModes": ["subprocess", "container"],
        "reason": "Markdown memory only needs plugin storage filesystem access."
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 }
        },
        "required": ["id"],
        "additionalProperties": false
      }
    }
  ],
  "memory": {
    "scopes": ["user", "project", "session", "agent", "plugin"],
    "namespaces": ["preferences", "facts", "projects", "tasks", "contacts", "self"],
    "retention": "user_controlled",
    "semanticSearch": false,
    "requiresApprovalForScopes": ["user"]
  },
  "permissions": {
    "filesystem": {
      "readRoots": [".andy/memory"],
      "writeRoots": [".andy/memory"]
    }
  }
}
